{
  "name": "sveltekit-prismic-starter-t-lemos",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:vite:dev\" \"npm:slicemachine\" --prefix-colors blue,magenta",
    "vite:dev": "vite dev --host",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . --plugin prettier-plugin-svelte . && eslint .",
    "format": "prettier --write . --plugin prettier-plugin-svelte .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "playwright test",
    "test:lhci": "lhci autorun",
    "export:rfp-pdf": "npx --yes md-to-pdf --config-file pdf.config.cjs docs/rfp-handbook.md",
    "slicemachine": "start-slicemachine"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.59.1",
    "@slicemachine/adapter-sveltekit": "^0.3.36",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/adapter-netlify": "^6.0.4",
    "@sveltejs/kit": "^2.5.27",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/svelte": "^5.3.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-svelte": "^3.1.0",
    "globals": "^17.5.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.1.1",
    "prettier-plugin-svelte": "^3.2.6",
    "slice-machine-ui": "^2.11.1",
    "svelte": "^5.23.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "typescript-svelte-plugin": "^0.3.36",
    "vite": "^8.0.2",
    "vitest": "^4.1.1"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@lucide/svelte": "^1.12.0",
    "@prismicio/client": "^7.3.1",
    "@prismicio/svelte": "^2.0.0",
    "@tailwindcss/vite": "^4.1.4",
    "@zerodevx/svelte-img": "^2.1.2",
    "svelte-gestures": "^5.0.7"
  }
}
